<Window x:Class="TodoAppWPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TodoAppWPFApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Border Background="#212529" CornerRadius="20,20,0,20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource ExitApp}" x:Name="ShutDownButton" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,15,15,0"/>

                <TextBox Style="{StaticResource specialTextbox}" Grid.Column="0" Grid.Row="0" Margin="40,40,0,0"/>

                <Button Style="{StaticResource ModStyledButton}" Grid.Row="0" Grid.Column="1" Margin="40,40,0,0" Content="Lägg till Uppgift"/>

                <ListBox Style="{StaticResource RoundListBox}" Grid.Row="1" Grid.ColumnSpan="2" Margin="40,20,0,20"/>

                <Button Style="{StaticResource ModStyledButton}" Grid.Row="2" Grid.Column="1" Margin="0,0,0,40" Content="Ta bort Uppgift"/>

            </Grid>
            
        </Border>
    </Grid>
</Window>
