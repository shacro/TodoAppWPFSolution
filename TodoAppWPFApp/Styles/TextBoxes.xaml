<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="specialTextbox" TargetType="TextBox">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#fd3301"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="15"
                            BorderBrush="Black"
                            BorderThickness="1"
                            Background="#272B2F"
                            Height="42">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="4,0,4,0" HorizontalAlignment="Left" VerticalAlignment="Center">

                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>