<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="modScrollviewer" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter Grid.Row="1" x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}"/>

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                            Grid.Row="1"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                            Style="{DynamicResource ModScrollbarVertical}"
                            Visibility="Collapsed"/>

                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                            Grid.Row="1"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Grid.Column="0"
                            Minimum="0"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                            Style="{DynamicResource ModScrollbarHorizontal}"
                            Margin="0,0,0,0"
                            Visibility="Collapsed"/>

                        <Rectangle Height="5" Grid.Row="0"/>

                        <Rectangle Height="4" Grid.Row="2"/>

                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="ComputedHorizontalScrollBarVisibility" Value="Visible">
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>



    <Style x:Key="ThumbEllipseStyleTwo" TargetType="Ellipse">
        <Setter Property="Fill" Value="LightGray"/>
    </Style>

    <Style x:Key="ModScrollbarHorizontal" TargetType="ScrollBar">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="False" ViewportSize="NaN" Margin="5,0,5,0" >
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse x:Name="thumpEllipse" Style="{StaticResource ThumbEllipseStyleTwo}"/>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseCaptured" Value="False">
                                                <Setter Property="Height" Value="25"/>
                                                <Setter Property="Width" Value="25"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseCaptured" Value="True">
                                                <Setter TargetName="thumpEllipse" Property="Fill" Value="white"/>
                                                <Setter Property="Height" Value="27"/>
                                                <Setter Property="Width" Value="27"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>

                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{DynamicResource DecreaseRbhH}"
                               Command="ScrollBar.PageDownCommand"/>
                        </Track.DecreaseRepeatButton>

                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{DynamicResource IncreaseRbhH}"
                               Command="ScrollBar.PageUpCommand"/>
                        </Track.IncreaseRepeatButton>
                    </Track>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <Style x:Key="ModScrollbarVertical" TargetType="ScrollBar">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" ViewportSize="NaN" Margin="0,5,0,5" >
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse x:Name="thumpEllipse" Style="{StaticResource ThumbEllipseStyleTwo}"/>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseCaptured" Value="False">
                                                <Setter Property="Height" Value="25"/>
                                                <Setter Property="Width" Value="25"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseCaptured" Value="True">
                                                <Setter TargetName="thumpEllipse" Property="Fill" Value="white"/>
                                                <Setter Property="Height" Value="27"/>
                                                <Setter Property="Width" Value="27"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>

                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{DynamicResource DecreaseRbhV}"
                                   Command="ScrollBar.PageDownCommand"/>
                        </Track.DecreaseRepeatButton>

                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{DynamicResource IncreaseRbhV}"
                                   Command="ScrollBar.PageUpCommand"/>
                        </Track.IncreaseRepeatButton>
                    </Track>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <Style x:Key="IncreaseRbhV" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Gray" Width="5" CornerRadius="0,0,3,3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DecreaseRbhV" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="#02ccfe" Width="5" CornerRadius="3,3,0,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IncreaseRbhH" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Gray" Height="5" CornerRadius="0,3,3,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DecreaseRbhH" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="#02ccfe" Height="5" CornerRadius="3,0,0,3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>